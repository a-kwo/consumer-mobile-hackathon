# Keys for the Score data pipeline. Copy this file to pipeline/.env and fill in ONE label key.
# The pipeline reads only pipeline/.env. It ignores keys that are set in your shell.
# pipeline/.env is gitignored. Never commit real keys.

# LLM that labels songs in label.py. Set exactly one of these.
LABEL_ANTHROPIC_API_KEY=
LABEL_OPENAI_API_KEY=

# Optional: override the labeling model (default is chosen per provider in label.py).
LABEL_MODEL=

# Optional: seed from Last.fm tags as well as Deezer playlists.
LASTFM_API_KEY=

# Optional: Anthropic effort for labeling (low | medium | high). Default: medium.
LABEL_EFFORT=
