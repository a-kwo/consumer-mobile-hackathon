{
  "expo": {
    "name": "Score",
    "slug": "consumer-mobile-hackathon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "consumermobilehackathon",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.akwo.consumermobilehackathon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EDE1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.akwo.consumermobilehackathon",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EDE1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Score lets you add your own photos to your soundtrack.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Score reads your step cadence to match the music to your pace."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Score uses your location for local weather and to name the places in your soundtrack."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/fraunces/400Regular/Fraunces_400Regular.ttf",
            "./node_modules/@expo-google-fonts/fraunces/400Regular_Italic/Fraunces_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/fraunces/500Medium/Fraunces_500Medium.ttf",
            "./node_modules/@expo-google-fonts/hanken-grotesk/400Regular/HankenGrotesk_400Regular.ttf",
            "./node_modules/@expo-google-fonts/hanken-grotesk/500Medium/HankenGrotesk_500Medium.ttf",
            "./node_modules/@expo-google-fonts/hanken-grotesk/600SemiBold/HankenGrotesk_600SemiBold.ttf"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-calendar",
        {
          "calendarPermission": "Score looks at your next calendar event to build the music towards it. Event details stay on your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
